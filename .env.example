# 로컬 개발용 공용 KIPRIS 키(사용자별 키가 없을 때만 대체 사용)
KIPRIS_API_KEY=
# 공공데이터포털 연계형 ServiceKey가 별도라면 설정합니다. 미설정 시 위 키를 사용합니다.
KIPRIS_SERVICE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Access 설정. 운영 환경에서는 두 값이 모두 필요합니다.
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=

# 32바이트 난수의 Base64 값. 사용자 API 키를 AES-GCM으로 암호화합니다.
APP_ENCRYPTION_KEY=
CLOUDFLARE_D1_DATABASE_ID=

# 로컬 개발에서만 인증 대체 사용. 운영 환경에서는 무시됩니다.
ALLOW_DEV_AUTH=true
