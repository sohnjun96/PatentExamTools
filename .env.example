# Cloudflare Worker Secret으로 등록할 KIPRIS Plus 키
KIPRIS_API_KEY=
# 공공데이터포털 연계형 ServiceKey가 별도라면 설정합니다. 미설정 시 위 키를 사용합니다.
KIPRIS_SERVICE_KEY=
# Cloudflare Worker Secret으로 등록할 OpenAI 키
OPENAI_API_KEY=
# 선택값. 미설정 시 gpt-5-mini
OPENAI_MODEL=gpt-5-mini
# 선택값. 별도 Node kordoc 파서 서비스를 배포한 경우에만 설정합니다.
KORDOC_API_URL=
KORDOC_API_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CLOUDFLARE_D1_DATABASE_ID=
